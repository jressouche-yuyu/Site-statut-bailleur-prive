---
/**
 * Encart éditorial (« à retenir », avertissement…).
 * Style « filet + intertitre » de presse, sans emoji ni marqueur générique.
 */
interface Props {
  title?: string;
  /** Teinte : info (encre) ou warning (laiton/ambre). */
  tone?: 'info' | 'warning';
}
const { title = 'À retenir', tone = 'info' } = Astro.props;
---

<aside class={`callout callout-${tone}`}>
  <p class="callout-kicker">{title}</p>
  <div class="callout-body">
    <slot />
  </div>
</aside>

<style>
  .callout {
    display: grid;
    gap: .55rem;
    margin: clamp(2rem, 5vw, 3.5rem) 0;
    padding: 1.15rem 0 0;
    border: 0;
    border-top: 1px solid var(--border-strong);
    background: transparent;
  }
  .callout-kicker {
    margin: 0;
    color: var(--text);
    font-family: var(--font-editorial);
    font-size: 1.2rem;
    font-weight: 600;
    letter-spacing: 0;
    line-height: 1.25;
    text-transform: none;
    text-wrap: balance;
  }
  .callout-body {
    min-width: 0;
    line-height: 1.65;
  }
  .callout-body :global(ul),
  .callout-body :global(ol) { padding-left: 1.25rem; }
  .callout-body :global(p:last-child),
  .callout-body :global(ul:last-child),
  .callout-body :global(ol:last-child) { margin-bottom: 0; }
  @media (min-width: 720px) {
    .callout {
      grid-template-columns: minmax(9rem, .32fr) minmax(0, 1fr);
      gap: clamp(1.5rem, 4vw, 3rem);
    }
  }
</style>
