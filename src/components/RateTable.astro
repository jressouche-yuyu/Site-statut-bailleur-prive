---
/**
 * Tableau des taux d'amortissement par catégorie de loyer (neuf / ancien).
 * Données factuelles, scannables et citables (SEO/GEO). Source unique :
 * src/data/dispositif.ts.
 */
import { loyerTiers, formatPct, formatEur } from '../data/dispositif';
---

<div class="table-wrap">
  <table>
    <caption class="sr-only">
      Taux d'amortissement annuel du statut du bailleur privé selon la catégorie
      de loyer et le type de bien, et plafond annuel de déduction par foyer fiscal.
    </caption>
    <thead>
      <tr>
        <th scope="col">Catégorie de loyer</th>
        <th scope="col">Neuf</th>
        <th scope="col">Ancien rénové</th>
        <th scope="col">Plafond annuel, par foyer fiscal</th>
      </tr>
    </thead>
    <tbody>
      {
        loyerTiers.map((tier) => (
          <tr>
            <th scope="row">{tier.label}</th>
            <td><span class="rate">{formatPct(tier.rateNeuf)}</span> / an</td>
            <td><span class="rate">{formatPct(tier.rateAncien)}</span> / an</td>
            <td>
              {formatEur(tier.deductionCap)}
              {tier.key !== 'intermediaire' && <span class="cap-cond"> si 50 % des revenus le sont</span>}
            </td>
          </tr>
        ))
      }
    </tbody>
  </table>
</div>

<p class="cap-note">
  Ce plafond s'apprécie <strong>par an et par foyer fiscal</strong>, tous logements
  amortis confondus — il n'est pas multiplié par le nombre de biens. Les paliers de
  10 000 € et 12 000 € supposent qu'au moins la moitié des revenus bruts tirés des
  logements amortis relève respectivement de la location sociale ou très sociale.
</p>

<style>
  .cap-cond {
    display: block;
    font-size: 0.82rem;
    color: var(--text-muted);
  }
  .cap-note {
    margin: var(--space-3) 0 0;
    font-size: 0.88rem;
    color: var(--text-muted);
  }
  .rate {
    font-weight: 800;
    color: var(--primary);
    font-variant-numeric: tabular-nums;
  }
  th[scope='row'] {
    background: transparent;
    font-weight: 600;
    white-space: normal;
  }
</style>
