---
/**
 * Bloc FAQ accessible (balises <details>).
 * Le contenu en clair est crucial pour le GEO : réponses courtes, factuelles,
 * directement citables. Le schéma FAQPage est injecté côté page.
 */
interface Props {
  items: { question: string; answer: string }[];
  title?: string;
}
const { items, title = 'Questions fréquentes' } = Astro.props;
---

<section class="faq" aria-labelledby={title ? 'faq-title' : undefined} aria-label={title ? undefined : 'Questions fréquentes'}>
  {title && <h2 id="faq-title">{title}</h2>}
  <div class="faq-list">
    {
      items.map((item) => (
        <details>
          <summary>{item.question}</summary>
          <p>{item.answer}</p>
        </details>
      ))
    }
  </div>
</section>

<style>
  .faq-list {
    display: grid;
    gap: var(--space-3);
  }
  details {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    padding: var(--space-4) var(--space-6);
  }
  summary {
    cursor: pointer;
    font-weight: 600;
    list-style: none;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    min-height: 24px;
  }
  summary::-webkit-details-marker {
    display: none;
  }
  /* Chevron en bordures CSS plutot qu'un caractere : le contenu genere est
     expose dans l'arbre d'accessibilite, la question etait lue suivie d'un
     « plus ». `float: right` remontait en plus le signe sur la premiere ligne
     des questions longues. #1d2a3f sur blanc = 14,43:1. */
  summary::after {
    content: '';
    flex: none;
    width: 9px;
    height: 9px;
    margin-right: 3px;
    border-right: 2px solid var(--primary);
    border-bottom: 2px solid var(--primary);
    transform: rotate(45deg) translate(-2px, -2px);
    transition: transform 0.15s ease;
  }
  details[open] summary::after {
    transform: rotate(-135deg) translate(-3px, -3px);
  }
  details p {
    margin: var(--space-3) 0 0;
    color: var(--text-muted);
  }
</style>
