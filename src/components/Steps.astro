---
/**
 * Infographie « Comment ça marche » — 3 à 4 étapes avec pictos SVG minimalistes.
 * Vectoriel et inline : zéro requête, parfait pour la perf (Core Web Vitals).
 */
interface Step {
  title: string;
  body: string;
}
interface Props {
  steps: Step[];
  title?: string;
}
const { steps, title } = Astro.props;

---

<section class="steps-block">
  {title && <h2 class="steps-heading">{title}</h2>}
  <ol class="steps-grid">
    {
      steps.map((step, i) => (
        <li class="step">
          <span class="step-num" aria-hidden="true">{i + 1}</span>
          <h3 class="step-title">{step.title}</h3>
          <p class="step-body">{step.body}</p>
        </li>
      ))
    }
  </ol>
</section>

<style>
  .steps-heading {
    margin-bottom: var(--space-8);
    max-width: 22ch;
  }
  .steps-grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--space-6);
    /* S'adapte à la largeur du conteneur (4 en pleine largeur, 2 en colonne étroite). */
    grid-template-columns: repeat(auto-fit, minmax(210px, 1fr));
  }
  .step {
    margin: 0;
    padding-top: var(--space-3);
    border-top: 2px solid var(--primary);
  }
  .step-num {
    display: block;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.9rem;
    line-height: 1;
    letter-spacing: -0.02em;
    font-variant-numeric: tabular-nums;
    color: var(--accent-ink);
    margin-bottom: var(--space-3);
  }
  .step-title {
    font-size: 1.08rem;
    margin: 0 0 var(--space-2);
  }
  .step-body {
    margin: 0;
    color: var(--text-muted);
    font-size: 0.95rem;
  }
</style>
