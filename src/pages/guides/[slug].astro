---
import type { GetStaticPaths } from 'astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import Faq from '../../components/Faq.astro';
import Callout from '../../components/Callout.astro';
import Cover from '../../components/Cover.astro';
import { guides, categoryIcon } from '../../data/guides';
import { photo } from '../../lib/photos';
import { articleSchema, breadcrumbSchema, faqSchema } from '../../lib/schema';
import { url, withBase } from '../../lib/url';
import Sources from '../../components/Sources.astro';

export const getStaticPaths = (() => {
  return guides.map((guide) => ({
    params: { slug: guide.slug },
    props: { guide },
  }));
}) satisfies GetStaticPaths;

const { guide } = Astro.props;
const cover = photo(`guide:${guide.slug}`);
const coverSrc = cover?.src ?? guide.cover;

const crumbs = [
  { name: 'Accueil', path: '/' },
  { name: 'Guides', path: '/guides' },
  { name: guide.title, path: `/guides/${guide.slug}` },
];

// Guides utiles à la question traitée, plutôt qu'une liste identique partout.
const relatedSlugs: Record<string, string[]> = {
  'conditions-eligibilite-dispositif-jeanbrun': ['comment-fonctionne-statut-bailleur-prive', 'dispositif-jeanbrun-ancien-travaux-dpe', 'risques-limites-dispositif-jeanbrun'],
  'comment-fonctionne-statut-bailleur-prive': ['conditions-eligibilite-dispositif-jeanbrun', 'rentabilite-dispositif-jeanbrun-exemple-chiffre', 'revente-plus-value-amortissement-jeanbrun'],
  'risques-limites-dispositif-jeanbrun': ['conditions-eligibilite-dispositif-jeanbrun', 'rentabilite-dispositif-jeanbrun-exemple-chiffre', 'revente-plus-value-amortissement-jeanbrun'],
  'revente-plus-value-amortissement-jeanbrun': ['risques-limites-dispositif-jeanbrun', 'comment-fonctionne-statut-bailleur-prive', 'rentabilite-dispositif-jeanbrun-exemple-chiffre'],
  'dispositif-jeanbrun-ancien-travaux-dpe': ['conditions-eligibilite-dispositif-jeanbrun', 'neuf-ou-ancien-dispositif-jeanbrun', 'risques-limites-dispositif-jeanbrun'],
};
const preferred = relatedSlugs[guide.slug] ?? [];
const related = [
  ...preferred.map((slug) => guides.find((g) => g.slug === slug)).filter((g) => g !== undefined),
  ...guides.filter((g) => g.slug !== guide.slug && !preferred.includes(g.slug) && g.category === guide.category),
  ...guides.filter((g) => g.slug !== guide.slug && !preferred.includes(g.slug) && g.category !== guide.category),
].slice(0, 3);

const jsonLd = [
  breadcrumbSchema(crumbs),
  articleSchema(guide, coverSrc),
  ...(guide.faq.length ? [faqSchema(guide.faq)] : []),
];

const fmtDate = (iso: string) =>
  new Date(iso).toLocaleDateString('fr-FR', { day: 'numeric', month: 'long', year: 'numeric' });
---

<BaseLayout
  title={guide.title}
  description={guide.description}
  path={`/guides/${guide.slug}`}
  image={coverSrc}
  ogType="article"
  publishedTime={new Date(guide.publishedAt).toISOString()}
  modifiedTime={new Date(guide.lastUpdated).toISOString()}
  jsonLd={jsonLd}
>
  <div class="container">
    <Breadcrumbs items={crumbs} />
    <div class="article-hero">
      <div class="article-hero-copy">
        <span class="badge badge-accent">{guide.category} · Guide pratique</span>
        <h1>{guide.title}</h1>
        <p class="meta">
          Par <a href={url('/a-propos')}>la rédaction Bailleur Privé</a> ·
          Publié le <time datetime={guide.publishedAt}>{fmtDate(guide.publishedAt)}</time> ·
          Mis à jour le <time datetime={guide.lastUpdated}>{fmtDate(guide.lastUpdated)}</time> ·
          {guide.readingMinutes} min de lecture
        </p>
      </div>
      <Cover src={coverSrc} alt={cover?.alt ?? guide.coverAlt ?? guide.title} credit={cover?.credit ?? guide.coverCredit} seed={guide.slug} variant="banner" icon={categoryIcon[guide.category]} loading="eager" class="guide-cover" />
    </div>
    <div class="reading-shell">
      <aside class="reading-rail" aria-label="Sommaire du guide">
        <p class="reading-rail-title">Dans ce guide</p>
        <ol>
          {guide.slug === 'conditions-eligibilite-dispositif-jeanbrun' && <li><a href="#criteres-apercu">Les critères en un coup d’œil</a></li>}
          {guide.sections.map((section, index) => <li><a href={`#guide-section-${index + 1}`}>{section.heading}</a></li>)}
        </ol>
      </aside>
      <div class="reading-content">
        <article class="prose">
          <p class="lead">{guide.intro}</p>
          {guide.slug === 'conditions-eligibilite-dispositif-jeanbrun' && (
            <>
              <Callout title="L’essentiel">
                <ul>
                  <li>Un logement situé dans un immeuble collectif.</li>
                  <li>Une location nue à titre de résidence principale, pendant au moins neuf ans.</li>
                  <li>Des plafonds de loyer et de ressources à respecter.</li>
                  <li>Dans l’ancien, des conditions spécifiques de travaux et de réhabilitation à examiner.</li>
                </ul>
              </Callout>
              <section aria-labelledby="criteres-apercu">
                <h2 id="criteres-apercu">Les critères en un coup d’œil</h2>
                <p>Ces repères présentent les principaux points à vérifier. Le détail dépend du logement, du projet et des textes applicables.</p>
                <div class="table-wrap" role="region" aria-label="Principaux critères d’éligibilité" tabindex="0">
                  <table>
                    <caption>Principaux critères à examiner</caption>
                    <thead><tr><th scope="col">Critère</th><th scope="col">Point à examiner</th></tr></thead>
                    <tbody>
                      <tr><th scope="row">Logement</th><td>Logement situé dans un immeuble collectif.</td></tr>
                      <tr><th scope="row">Location</th><td>Location nue à usage de résidence principale.</td></tr>
                      <tr><th scope="row">Engagement</th><td>Au moins neuf ans, sous les conditions applicables.</td></tr>
                      <tr><th scope="row">Plafonds</th><td>Loyer et ressources du locataire à vérifier selon le projet.</td></tr>
                      <tr><th scope="row">Ancien</th><td>Conditions de travaux et critères de réhabilitation à examiner.</td></tr>
                    </tbody>
                  </table>
                </div>
              </section>
            </>
          )}
          {guide.sections.map((section, index) => (
            <section id={`guide-section-${index + 1}`}>
              <h2>{section.heading}</h2>
              <Fragment set:html={withBase(section.body)} />
            </section>
          ))}
          <Callout title="Rappel"><p>Contenu informatif fondé sur la loi de finances pour 2026. Il ne remplace pas un conseil fiscal personnalisé : vérifiez les textes en vigueur avant toute décision. Voir la <a href={url('/dispositif-jeanbrun')}> page de référence du dispositif</a>.</p></Callout>
        </article>
        {guide.faq.length > 0 && <Faq items={guide.faq} />}
        <aside class="related"><h2>À lire aussi</h2><ul>{related.map((g) => <li><a href={url(`/guides/${g.slug}`)}>{g.title}</a></li>)}<li><a href={url('/simulateur')}>Simuler mon amortissement</a></li></ul></aside>
        <Sources extra={guide.slug === 'revente-plus-value-amortissement-jeanbrun' || guide.slug === 'risques-limites-dispositif-jeanbrun' ? [{ label: 'Calcul de la plus-value : article 150 VB du code général des impôts', editeur: 'Légifrance', url: 'https://www.legifrance.gouv.fr/codes/article_lc/LEGIARTI000024576901' }] : []} />
      </div>
    </div>
  </div>
</BaseLayout>

<style>
  .prose .meta {
    color: var(--text-muted);
    font-size: 0.9rem;
  }
  .prose .badge {
    margin-bottom: var(--space-3);
  }
  .guide-cover {
    margin: var(--space-6) 0 var(--space-8);
  }
  .related {
    margin-top: var(--space-12);
    padding: var(--space-6);
    background: var(--bg-soft);
    border: 1px solid var(--border);
    border-radius: var(--radius);
  }
  .related h2 {
    margin-top: 0;
  }
  .related ul {
    margin: 0;
  }
</style>
