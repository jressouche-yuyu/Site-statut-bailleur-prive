---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import Callout from '../components/Callout.astro';
import { loyerTiers, dispositif } from '../data/dispositif';
import { breadcrumbSchema, howToSchema } from '../lib/schema';
import { url } from '../lib/url';
import { SITE } from '../consts';
import Sources from '../components/Sources.astro';

const crumbs = [
  { name: 'Accueil', path: '/' },
  { name: "Simulateur d'amortissement", path: '/simulateur' },
];

// Données transmises au script client.
const tiersData = loyerTiers.map((t) => ({
  key: t.key,
  label: t.label,
  rateNeuf: t.rateNeuf,
  rateAncien: t.rateAncien,
  cap: t.deductionCap,
}));
const config = {
  share: dispositif.amortizableShare,
  years: dispositif.engagementYears,
};

// Cas concrets pré-remplis (réalistes, à titre d'exemple).
const presets = [
  {
    id: 'studio-neuf',
    label: 'Studio neuf · loyer intermédiaire',
    sub: '≈ 165 000 € · Nantes',
    values: { price: 165000, segment: 'neuf', tier: 'intermediaire', rent: 520, charges: 1500, interests: 3400, tmi: '0.30' },
  },
  {
    id: 't2-neuf-social',
    label: 'T2 neuf · loyer social',
    sub: '≈ 230 000 € · Lyon',
    values: { price: 230000, segment: 'neuf', tier: 'social', rent: 690, charges: 2200, interests: 5200, tmi: '0.41' },
  },
  {
    id: 't3-ancien',
    label: 'T3 ancien rénové · loyer intermédiaire',
    sub: '≈ 250 000 € · Lille',
    values: { price: 250000, segment: 'ancien', tier: 'intermediaire', rent: 880, charges: 2600, interests: 5600, tmi: '0.30' },
  },
];

const jsonLd = [
  breadcrumbSchema(crumbs),
  howToSchema({
    name: "Simuler l'amortissement et l'économie d'impôt du dispositif Jeanbrun",
    description: "Estimer l'amortissement, le revenu foncier imposable et l'économie d'impôt du statut du bailleur privé selon un projet réel.",
    steps: [
      { title: "Décrire le bien et le loyer", body: 'Prix, neuf ou ancien, catégorie de loyer et loyer mensuel perçu.' },
      { title: 'Ajouter charges et intérêts', body: 'Charges déductibles annuelles et intérêts d\'emprunt pour un calcul réaliste.' },
      { title: 'Renseigner votre tranche d\'imposition', body: 'Pour comparer l\'impôt avec et sans le dispositif et l\'économie sur 9 ans.' },
    ],
  }),
  {
    '@context': 'https://schema.org',
    '@type': 'WebApplication',
    name: 'Simulateur du dispositif Jeanbrun',
    url: `${SITE.url}/simulateur/`,
    applicationCategory: 'FinanceApplication',
    operatingSystem: 'Web',
    inLanguage: SITE.lang,
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'EUR' },
    publisher: { '@id': `${SITE.url}/#organization` },
  },
];
---

<BaseLayout
  title="Simulateur dispositif Jeanbrun : amortissement & économie d'impôt"
  description="Simulateur avancé du statut du bailleur privé : amortissement, revenu foncier imposable, comparaison avec/sans dispositif et économie d'impôt sur 9 ans, à partir d'un cas réel (loyer, charges, intérêts, TMI)."
  path="/simulateur"
  jsonLd={jsonLd}
>
  <div class="container container-narrow">
    <Breadcrumbs items={crumbs} />
    <p class="eyebrow">Outil gratuit · calcul instantané</p>
    <h1>Simulateur du statut du bailleur privé</h1>
    <p class="lead">
      Un simulateur complet et concret : il compare votre impôt foncier
      <strong> avec et sans</strong> le dispositif Jeanbrun, année par année, et
      estime une <strong>économie d'impôt sur 9 ans</strong> sous hypothèses constantes. En cas de déficit, le calcul fiscal nécessite une analyse complémentaire.
    </p>

    <div class="presets">
      <span class="presets-label">Charger un cas concret :</span>
      <div class="presets-row">
        {
          presets.map((p) => (
            <button type="button" class="preset" data-preset={p.id}>
              <span class="preset-label">{p.label}</span>
              <span class="preset-sub">{p.sub}</span>
            </button>
          ))
        }
      </div>
    </div>

    <form id="sim-form" class="sim card" novalidate>
      <div class="field">
        <label for="price">Prix d'acquisition (€)</label>
        <input type="number" id="price" name="price" min="0" step="1000" value="230000" inputmode="numeric" />
      </div>

      <div class="field">
        <span class="field-label">Type de bien</span>
        <div class="radio-row" role="radiogroup" aria-label="Type de bien">
          <label class="radio"><input type="radio" name="segment" value="neuf" checked /> Neuf</label>
          <label class="radio"><input type="radio" name="segment" value="ancien" /> Ancien rénové</label>
        </div>
      </div>

      <div class="field" id="field-travaux" hidden>
        <label for="travaux">Montant des travaux (€)</label>
        <input type="number" id="travaux" name="travaux" min="0" step="1000" value="60000" inputmode="numeric" />
        <p class="hint">Dans l'ancien, certains travaux s'ajoutent au prix avant application des 80 %. L'éligibilité dépend des travaux et des critères de réhabilitation lourde : ce calcul ne les vérifie pas.</p>
      </div>

      <div class="field">
        <label for="tier">Catégorie de loyer</label>
        <select id="tier" name="tier">
          {loyerTiers.map((t) => <option value={t.key}>{t.label}</option>)}
        </select>
      </div>

      <div class="field">
        <label for="rent">Loyer mensuel perçu (€, hors charges)</label>
        <input type="number" id="rent" name="rent" min="0" step="10" value="690" inputmode="numeric" />
      </div>

      <div class="field">
        <label for="charges">Charges annuelles déductibles (€)</label>
        <input type="number" id="charges" name="charges" min="0" step="100" value="2200" inputmode="numeric" />
        <p class="hint">Taxe foncière, assurance, gestion, copropriété non récupérable…</p>
      </div>

      <div class="field">
        <label for="interests">Intérêts d'emprunt annuels (€)</label>
        <input type="number" id="interests" name="interests" min="0" step="100" value="5200" inputmode="numeric" />
        <p class="hint">Moyenne annuelle des intérêts (hors capital).</p>
      </div>

      <div class="field">
        <label for="tmi">Tranche marginale d'imposition (TMI)</label>
        <select id="tmi" name="tmi">
          <option value="0">0 %</option>
          <option value="0.11">11 %</option>
          <option value="0.30" selected>30 %</option>
          <option value="0.41">41 %</option>
          <option value="0.45">45 %</option>
        </select>
        <p class="hint">+ 17,2 % de prélèvements sociaux appliqués au revenu foncier.</p>
      </div>

      <div class="field">
        <label for="mensualite">Mensualité de crédit (€, optionnel)</label>
        <input type="number" id="mensualite" name="mensualite" min="0" step="10" value="0" inputmode="numeric" />
        <p class="hint">Pour estimer l'effort d'épargne mensuel. Laissez 0 si non concerné.</p>
      </div>
    </form>

    <!-- Synthèse chiffrée -->
    <section class="results" id="results">
      <p class="sr-only" role="status" id="r-status"></p>
      <div class="result-cards">
        <div class="result-card">
          <p class="result-label">Amortissement théorique / an</p>
          <p class="result-value" id="r-annual">—</p>
          <p class="result-foot" id="r-rate">—</p>
        </div>
        <div class="result-card accent">
          <p class="result-label">Économie d'impôt / an</p>
          <p class="result-value" id="r-save">—</p>
          <p class="result-foot" id="r-save-foot">avec le dispositif Jeanbrun</p>
        </div>
        <div class="result-card accent">
          <p class="result-label">Économie sur 9 ans</p>
          <p class="result-value" id="r-save9">—</p>
          <p class="result-foot">si les hypothèses restent constantes</p>
        </div>
        <div class="result-card">
          <p class="result-label">Effort d'épargne / mois</p>
          <p class="result-value" id="r-effort">—</p>
          <p class="result-foot" id="r-effort-foot">crédit + charges + impôt estimé − loyer</p>
        </div>
      </div>

      <!-- Graphique comparatif -->
      <div class="chart card" id="tax-chart">
        <h2 class="chart-title">Impôt foncier annuel : avec vs sans dispositif</h2>
        <div id="chart" class="chart-area"></div>
        <p class="chart-note" id="chart-note"></p>
      </div>

      <!-- Détail du calcul -->
      <div class="card detail">
        <h2 class="detail-title">Le détail du calcul (par an)</h2>
        <div class="table-wrap">
          <table>
            <thead>
              <tr><th>Poste</th><th>Sans dispositif</th><th>Avec Jeanbrun</th></tr>
            </thead>
            <tbody>
              <tr><td>Loyers perçus</td><td id="d-rent-1">—</td><td id="d-rent-2">—</td></tr>
              <tr><td>− Charges déductibles</td><td id="d-charges-1">—</td><td id="d-charges-2">—</td></tr>
              <tr><td>− Intérêts d'emprunt</td><td id="d-int-1">—</td><td id="d-int-2">—</td></tr>
              <tr><td>− Amortissement</td><td id="d-amort-1">—</td><td id="d-amort-2">—</td></tr>
              <tr class="row-strong"><td>= Résultat foncier estimé</td><td id="d-base-1">—</td><td id="d-base-2">—</td></tr>
              <tr><td>Impôt + prélèvements sociaux</td><td id="d-tax-1">—</td><td id="d-tax-2">—</td></tr>
            </tbody>
          </table>
        </div>
        <p class="detail-narrative" id="narrative"></p>
      </div>
    </section>

    <Callout title="Comment lire ce résultat ?">
      <p>
        L'amortissement est une déduction des revenus fonciers. Les montants
        fiscaux affichés supposent une année pleine, un seul bien, aucun déficit
        antérieur et un taux d'imposition constant. Le total sur neuf ans répète
        ces hypothèses : il ne constitue pas un échéancier personnalisé.
        En cas de déficit, le simulateur ne chiffre pas l'économie fiscale :
        son imputation dépend notamment de l'ensemble de votre situation.
      </p>
    </Callout>

    <Callout title="Estimation indicative — pas un conseil fiscal" tone="warning">
      <p>
        Calcul simplifié : il ne tient pas compte de toute votre situation (autres
        revenus fonciers, déficits antérieurs, variation de taux d'imposition,
        première année incomplète, plus-value à la revente, plafonds spécifiques). Les taux et plafonds reflètent la version
        issue de la loi de finances pour 2026 et peuvent évoluer. Ce simulateur
        ne vérifie ni votre éligibilité ni les plafonds de loyer applicables.
        Pour la méthode, voir
        <a href={url('/guides/comment-fonctionne-statut-bailleur-prive')}> notre guide</a> et la
        <a href="https://www.service-public.gouv.fr/particuliers/vosdroits/F39735">fiche Service Public</a>.
      </p>
    </Callout>
    <Sources />
  </div>
</BaseLayout>

<script define:vars={{ tiersData, config, presets }}>
  const eur = new Intl.NumberFormat('fr-FR', { style: 'currency', currency: 'EUR', maximumFractionDigits: 0 });
  const SOCIAL = 0.172;

  const form = document.getElementById('sim-form');
  const get = (id) => document.getElementById(id);
  const num = (id) => Math.max(0, Number(get(id).value) || 0);


  function compute() {
    const price = num('price');
    const segment = form.querySelector('input[name="segment"]:checked').value;
    const tier = tiersData.find((t) => t.key === get('tier').value);
    if (!tier) return;
    const rent = num('rent');
    const charges = num('charges');
    const interests = num('interests');
    const mensualite = num('mensualite');
    const rate = (Number(get('tmi').value) || 0) + SOCIAL;
    const aRate = segment === 'neuf' ? tier.rateNeuf : tier.rateAncien;
    get('field-travaux').hidden = segment !== 'ancien';
    const travaux = segment === 'ancien' ? num('travaux') : 0;
    const loyers = rent * 12;
    const base = (price + travaux) * config.share;
    // Hypothèse : un seul logement Jeanbrun dans le foyer, année complète.
    const amort = Math.min(base * aRate, tier.cap);
    const netSans = loyers - charges - interests;
    const netAvec = netSans - amort;
    const hasDeficit = netSans < 0 || netAvec < 0;
    const taxSans = netSans * rate;
    const taxAvec = netAvec * rate;
    const saveYear = taxSans - taxAvec;
    const save9 = saveYear * config.years;
    // La mensualité inclut déjà les intérêts : ne pas les compter deux fois.
    const effortMonth = mensualite + charges / 12 + taxAvec / 12 - rent;

    get('r-annual').textContent = eur.format(amort);
    get('r-rate').textContent = `${(aRate * 100).toLocaleString('fr-FR', { minimumFractionDigits: 1, maximumFractionDigits: 1 })} % · base ${eur.format(base)}`;
    get('d-rent-1').textContent = get('d-rent-2').textContent = eur.format(loyers);
    get('d-charges-1').textContent = get('d-charges-2').textContent = '− ' + eur.format(charges);
    get('d-int-1').textContent = get('d-int-2').textContent = '− ' + eur.format(interests);
    get('d-amort-1').textContent = '—';
    get('d-amort-2').textContent = '− ' + eur.format(amort);
    get('d-base-1').textContent = eur.format(netSans);
    get('d-base-2').textContent = eur.format(netAvec);
    get('tax-chart').hidden = hasDeficit;

    if (hasDeficit) {
      get('r-save').textContent = '—';
      get('r-save9').textContent = '—';
      get('r-effort').textContent = '—';
      get('r-save-foot').textContent = 'déficit : calcul personnalisé nécessaire';
      get('r-effort-foot').textContent = 'calcul fiscal nécessaire';
      get('d-tax-1').textContent = 'Non calculé';
      get('d-tax-2').textContent = 'Non calculé';
      get('chart').innerHTML = '';
      get('chart-note').textContent = '';
      get('narrative').textContent = `Le résultat foncier estimé est de ${eur.format(netSans)} sans dispositif et ${eur.format(netAvec)} après amortissement théorique. Un déficit apparaît : son imputation dépend de l'ensemble de vos revenus fonciers, de vos intérêts et de votre situation fiscale. L'économie d'impôt et l'effort d'épargne ne sont pas calculés ici.`;
      get('r-status').textContent = `Amortissement théorique ${eur.format(amort)} par an. Déficit : économie d'impôt non calculée.`;
      return;
    }

    get('r-save').textContent = eur.format(saveYear);
    get('r-save9').textContent = eur.format(save9);
    get('r-save-foot').textContent = 'estimation pour une année pleine';
    get('r-effort').textContent = mensualite > 0 ? eur.format(Math.max(0, effortMonth)) : '—';
    get('r-effort-foot').textContent = mensualite > 0
      ? (effortMonth <= 0 ? 'aucun effort mensuel estimé' : 'à financer chaque mois')
      : 'renseignez la mensualité';
    get('d-tax-1').textContent = eur.format(taxSans);
    get('d-tax-2').textContent = eur.format(taxAvec);
    get('r-status').textContent = `Amortissement théorique ${eur.format(amort)} par an, économie estimée ${eur.format(saveYear)} pour une année pleine.`;
    get('narrative').textContent = `Pour ${eur.format(loyers)} de loyers annuels, le résultat foncier estimé passe de ${eur.format(netSans)} à ${eur.format(netAvec)} après amortissement théorique. Avec le taux indiqué et 17,2 % de prélèvements sociaux, l'économie estimée est de ${eur.format(saveYear)} pour une année pleine. Le total de ${eur.format(save9)} sur ${config.years} ans suppose des revenus, charges, taux et règles inchangés.`;
    drawChart(taxSans, taxAvec);
    get('chart-note').textContent = `Économie estimée pour une année pleine : ${eur.format(saveYear)}.`;
  }

  // Graphique en barres (SVG) : impôt sans vs avec
  function drawChart(taxSans, taxAvec) {
    // Marge en haut (padT) pour ne pas tronquer l'étiquette de valeur, et 10 %
    // de hauteur en réserve pour que la plus grande barre ne touche pas le bord.
    const max = Math.max(taxSans, taxAvec, 1) * 1.1;
    const w = 520, h = 220, padL = 16, padB = 38, padT = 34, barW = 150, gap = 90;
    const usableH = h - padB - padT;
    const x1 = padL + 60, x2 = x1 + barW + gap;
    const bar = (x, val, color, label) => {
      const bh = Math.max(2, (val / max) * usableH);
      const y = padT + usableH - bh;
      return `
        <rect x="${x}" y="${y}" width="${barW}" height="${bh}" rx="6" fill="${color}" />
        <text x="${x + barW / 2}" y="${y - 9}" text-anchor="middle" class="bar-val">${eur.format(val)}</text>
        <text x="${x + barW / 2}" y="${h - 12}" text-anchor="middle" class="bar-lbl">${label}</text>`;
    };
    const svg = `
      <svg viewBox="0 0 ${w} ${h}" width="100%" role="img" aria-label="Comparaison de l'impôt foncier annuel avec et sans le dispositif">
        <line x1="${padL}" y1="${padT + usableH}" x2="${w - padL}" y2="${padT + usableH}" stroke="var(--border)" />
        ${bar(x1, taxSans, 'var(--text-muted)', 'Sans dispositif')}
        ${bar(x2, taxAvec, 'var(--accent)', 'Avec Jeanbrun')}
      </svg>`;
    get('chart').innerHTML = svg;
  }

  function applyPreset(p) {
    get('price').value = p.values.price;
    form.querySelector(`input[name="segment"][value="${p.values.segment}"]`).checked = true;
    get('tier').value = p.values.tier;
    get('rent').value = p.values.rent;
    get('charges').value = p.values.charges;
    get('interests').value = p.values.interests;
    get('tmi').value = p.values.tmi;
    get('mensualite').value = 0; // réinitialise : un cas-type n'impose pas de mensualité
    compute();
  }

  function setActivePreset(btn) {
    document.querySelectorAll('[data-preset]').forEach((b) => {
      const on = b === btn;
      b.classList.toggle('is-active', on);
      b.setAttribute('aria-pressed', String(on));
    });
  }

  document.querySelectorAll('[data-preset]').forEach((btn) => {
    btn.setAttribute('aria-pressed', 'false');
    btn.addEventListener('click', () => {
      const p = presets.find((x) => x.id === btn.getAttribute('data-preset'));
      if (p) applyPreset(p);
      setActivePreset(btn);
    });
  });

  // Dès que l'utilisateur touche un champ, le cas-type n'est plus celui affiché :
  // l'état visuel doit lâcher, sinon l'interface ment.
  form.addEventListener('input', () => setActivePreset(null));

  let debounce;
  form.addEventListener('input', () => {
    clearTimeout(debounce);
    debounce = setTimeout(compute, 250);
  });
  compute();
</script>

<style>
  .presets {
    margin-top: var(--space-8);
  }
  .presets-label {
    font-weight: 600;
    font-size: 0.9rem;
    color: var(--text-muted);
  }
  .presets-row {
    display: grid;
    gap: var(--space-3);
    margin-top: var(--space-3);
    grid-template-columns: 1fr;
  }
  @media (min-width: 640px) {
    .presets-row {
      grid-template-columns: repeat(3, 1fr);
    }
  }
  .preset {
    text-align: left;
    background: var(--surface);
    border: 1px solid var(--border-strong);
    border-radius: var(--radius-sm);
    padding: var(--space-3) var(--space-4);
    cursor: pointer;
    transition: border-color 0.15s ease, box-shadow 0.15s ease;
  }
  .preset:hover {
    border-color: var(--primary);
  }
  .preset.is-active {
    border-color: var(--primary);
    border-left-width: 4px;
    padding-left: calc(var(--space-4) - 3px);
    box-shadow: 0 0 0 2px color-mix(in srgb, var(--primary) 18%, transparent);
  }
  .preset-label {
    display: block;
    font-weight: 700;
    font-size: 1rem;
  }
  .preset-sub {
    display: block;
    color: var(--text-muted);
    font-size: 0.82rem;
  }

  .sim {
    display: grid;
    gap: var(--space-6);
    margin-top: var(--space-4);
  }
  @media (min-width: 640px) {
    .sim {
      grid-template-columns: 1fr 1fr;
    }
  }
  .field {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }
  label,
  .field-label {
    font-weight: 600;
    font-size: 1rem;
  }
  input[type='number'],
  select {
    font: inherit;
    padding: var(--space-3);
    border: 1px solid var(--border-strong);
    border-radius: var(--radius-sm);
    background: var(--bg);
    color: var(--text);
    width: 100%;
  }
  .radio-row {
    display: flex;
    gap: var(--space-4);
    flex-wrap: wrap;
  }
  .radio {
    font-weight: 500;
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
  }
  .hint {
    margin: 0;
    font-size: 0.82rem;
    color: var(--text-muted);
  }

  .results {
    margin-top: var(--space-8);
    display: grid;
    /* minmax(0, 1fr) et non 1fr : sinon min-width:auto laisse le tableau
       imposer sa largeur de contenu et deux cartes sortent du cadre a 375px
       — rognees par main{overflow-x:clip}, donc definitivement perdues. */
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-6);
  }
  .result-cards {
    display: grid;
    gap: var(--space-4);
    grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));
  }
  .result-card {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: var(--space-4) var(--space-6);
    box-shadow: var(--shadow-sm);
  }
  .result-card.accent {
    background: var(--accent-soft);
    border-color: color-mix(in srgb, var(--accent) 45%, transparent);
  }
  .result-label {
    margin: 0 0 var(--space-1);
    font-size: 0.82rem;
    color: var(--text-muted);
  }
  .result-value {
    margin: 0;
    font-size: 1.6rem;
    font-weight: 800;
    font-variant-numeric: tabular-nums;
    line-height: 1.1;
  }
  .result-card.accent .result-value {
    color: var(--accent);
  }
  .result-foot {
    margin: var(--space-1) 0 0;
    font-size: 0.78rem;
    color: var(--text-muted);
  }

  .chart-title,
